{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "build/client",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/contact.html",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/thank-you",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/thank-you.html",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/portfolio",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/portfolio.html",
      "destination": "/",
      "permanent": false
    }
  ]
}
