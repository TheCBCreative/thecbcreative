# Contact form webhook (api/contact.mjs)
#
# Copy to .env for local development. On Vercel, set these under
# Project Settings -> Environment Variables instead — .env is gitignored
# and never deployed.

# API key from https://resend.com (Dashboard -> API Keys).
# NEVER put the real key in this file — .env.example is deliberately NOT
# gitignored (see the !.env.example line in .gitignore) so it ships to the
# repo as documentation. Real values go in .env (gitignored) locally, and
# in Vercel's Environment Variables settings for deployments.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. The domain must be verified in Resend before it will
# send — add thecbcreative.com under Domains and follow the DNS steps.
# "onboarding@resend.dev" works without a verified domain, but only
# delivers to the email you signed up with, so it's test-only.
CONTACT_FROM_EMAIL="The CB Creative <inquiries@thecbcreative.com>"

# Where form submissions land.
CONTACT_TO_EMAIL=cait@thecbcreative.com
