# Contact form (api/contact.mjs). Copy to .env.local for `npm run dev`; on Vercel, set these under
# Project Settings → Environment Variables. Never put real values in this file — it's committed.

# API key from resend.com (Dashboard → API Keys).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender. The domain must be verified in Resend (onboarding@resend.dev works for testing only).
CONTACT_FROM_EMAIL="The CB Creative <inquiries@thecbcreative.com>"

# Where submissions land.
CONTACT_TO_EMAIL=cait@thecbcreative.com
